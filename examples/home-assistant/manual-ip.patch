+def _schema(default: str = "") -> vol.Schema:
+    return vol.Schema({vol.Optional(CONF_DEVICE_IP, default=default): str})
+
+
+def _address(user_input: dict) -> str:
+    value = user_input.get(CONF_DEVICE_IP, "").strip()
+    return str(IPv4Address(value)) if value else ""
+
+
+class GoveeConfigFlow(ConfigFlow, domain=DOMAIN):
+    VERSION = 1
+
+    @staticmethod
+    @callback
+    def async_get_options_flow(config_entry: ConfigEntry) -> OptionsFlowWithReload:
+        return GoveeOptionsFlow()
+
+    async def async_step_user(self, user_input=None):
+        if self._async_current_entries():
+            return self.async_abort(reason="single_instance_allowed")
+        errors = {}
+        if user_input is not None:
+            try:
+                address = _address(user_input)
+            except ValueError:
+                errors[CONF_DEVICE_IP] = "invalid_ip"
+            else:
+                if await _async_has_devices(self.hass, address):
+                    return self.async_create_entry(
+                        title="Govee lights local", data={CONF_DEVICE_IP: address}
+                    )
+                errors["base"] = "no_devices_found"
+        return self.async_show_form(
+            step_id="user", data_schema=_schema(), errors=errors
+        )
+
+
+class GoveeOptionsFlow(OptionsFlowWithReload):
+    async def async_step_init(self, user_input=None):
+        entry = self.config_entry
+        current = entry.options.get(CONF_DEVICE_IP, entry.data.get(CONF_DEVICE_IP, ""))
+        errors = {}
+        if user_input is not None:
+            try:
+                address = _address(user_input)
+            except ValueError:
+                errors[CONF_DEVICE_IP] = "invalid_ip"
+            else:
+                return self.async_create_entry(
+                    data={**entry.options, CONF_DEVICE_IP: address}
+                )
+        return self.async_show_form(
+            step_id="init", data_schema=_schema(current), errors=errors
+        )
